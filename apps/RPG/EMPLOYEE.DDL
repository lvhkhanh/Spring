-- Simple DB2 table for AS/400 RPG CRUD demo
CREATE TABLE EMPLOYEE (
  EMPID INT GENERATED ALWAYS AS IDENTITY (START WITH 1 INCREMENT BY 1),
  FIRSTNAME VARCHAR(30) NOT NULL,
  LASTNAME VARCHAR(30) NOT NULL,
  AGE SMALLINT,
  PRIMARY KEY (EMPID)
);

INSERT INTO EMPLOYEE (FIRSTNAME, LASTNAME, AGE) VALUES ('Alice', 'Brown', 30);
INSERT INTO EMPLOYEE (FIRSTNAME, LASTNAME, AGE) VALUES ('Bob', 'Smith', 42);
